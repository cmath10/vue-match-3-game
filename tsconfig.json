{
  "compilerOptions": {
    "target": "ES2022",
    "noImplicitAny": true,
    "incremental": true,
    "module": "ESNext",
    "strict": false,
    "jsx": "preserve",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "types": [
      "vite/client"
    ],
    "allowJs": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "lib": [
      "ES2022",
      "dom",
      "dom.iterable"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "vite.config.ts",
    "shims.d.ts"
  ],
  "references": []
}
